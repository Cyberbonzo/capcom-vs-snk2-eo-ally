+static bool wide_backdrop(const Batch& b, const Cmd& c, const PixelState& st, float& anchor_y) {
+    if (!native_wide_enabled() || c.count > 192 || c.vcount < 4 || samples_fullscreen_copy(st)) return false;
+    const float height = static_cast<float>(g_ordered_scanout.height);
+    if (height <= 0) return false;
+    int xo, yo; scissor_offset(st.bp, xo, yo);
+    float x0 = 1e30f, y0 = 1e30f, x1 = -1e30f, y1 = -1e30f;
+    float z0 = 1e30f, z1 = -1e30f;
+    const float* p = st.proj;
+    for (uint32_t j = 0; j < c.vcount; ++j) {
+        const float* v = b.verts[c.vfirst + j].pos;
+        z0 = std::min(z0, v[2]); z1 = std::max(z1, v[2]);
+        const bool perspective = static_cast<int>(p[6]) == 0;
+        const float w = perspective ? -v[2] : 1.0f;
