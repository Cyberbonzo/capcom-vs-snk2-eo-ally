+    // A partial first copy can start below row zero. VI supplies the base when
+    // that is the active buffer; otherwise an already-known XFB supplies it.
+    if (scanout.address && c.dest >= scanout.address &&
+        uint64_t(c.dest) < uint64_t(scanout.address) + uint64_t(stride) * h &&
+        (c.dest - scanout.address) % stride == 0)
+        base = scanout.address;
+    Xfb& x = xfb_for(base, c.dst_w, stride, h, c.dst_h >= h || base == scanout.address);
+    if (c.dest < x.base || (c.dest - x.base) % stride != 0) return;
+    const uint32_t row0 = (c.dest - x.base) / stride;
+    if (row0 >= h) return;
